<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarrotNote" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="colorPrimary">@color/carrot</item>
        <item name="colorAccent">@color/carrot</item>
    </style>

    <style name="WidgetTask">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#1E1A17</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
