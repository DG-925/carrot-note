<?xml version="1.0" encoding="utf-8"?>
<!-- "Owed to you" widget: unpaid invoices and debts, and what you owe. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/o_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_butter"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_w_debt"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/o_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Owed to you"
            android:textColor="@color/w_text"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/o_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-black"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="9,980 EGP"
        android:textColor="@color/w_text"
        android:textSize="22sp" />
    <TextView
        android:id="@+id/o_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Invoices 8,980 · Debts 1,000"
        android:textColor="@color/w_muted"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/o_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/o_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">
            <TextView
                android:id="@+id/o_who1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Nour Bakery · INV-0001"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/o_amt1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="4,980"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/o_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">
            <TextView
                android:id="@+id/o_who2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Lina Hassan · INV-0002"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/o_amt2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="4,000"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/o_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">
            <TextView
                android:id="@+id/o_who3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Karim Adel"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/o_amt3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="1,000"
                android:textColor="@color/w_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/o_iowe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="You owe 2,000 EGP"
        android:textColor="@color/w_bad"
        android:textSize="12sp" />
</LinearLayout>
